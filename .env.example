# ---------- 应用 ----------
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8002
LOG_LEVEL=INFO
# 生产必须显式列出来源，禁止通配符
CORS_ORIGINS=http://127.0.0.1:8002,http://localhost:8002

# ---------- 数据库 ----------
# 开发用 SQLite（零依赖可跑冒烟）；生产切 MySQL 只改这一行
DATABASE_URL=sqlite:///./yoga.db
# DATABASE_URL=mysql+pymysql://user:password@host:3306/yuekeDB?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=10

# ---------- 认证 ----------
# 生产必须替换为随机长字符串；真实密钥只放 .env / 环境变量，绝不提交
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# ---------- 微信小程序 ----------
WX_APPID=
WX_SECRET=
# 本地联调：留空凭证时用 mock openid，避免阻塞开发
WX_MOCK=true

# ---------- 开发种子 ----------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
SEED_DEMO=true
