# 生产环境变量模板（复制为 .env 后填写，切勿提交）
# 说明：首次上线建议先用 APP_ENV=staging 跑通，拿到微信 AppID/Secret 与 HTTPS 域名后再切 prod。
#       prod 模式会强制校验：MySQL、非 change-me 密钥、关闭 WX_MOCK、CORS 非通配符。

APP_ENV=staging
APP_HOST=0.0.0.0
APP_PORT=8002
LOG_LEVEL=INFO
WORKERS=2

# 必须具体列出前端来源（小程序请求不受 CORS 限制，后台同源部署也不需要通配符）
CORS_ORIGINS=https://your-domain.example

# ---------- 数据库（生产必须是 MySQL 8.0.16+，CHECK 约束才生效）----------
# docker compose 内部主机名为 mysql
DATABASE_URL=mysql+pymysql://yoga:CHANGE_ME_DB_PASSWORD@mysql:3306/yoga?charset=utf8mb4
DB_POOL_SIZE=10
DB_ECHO=false

# ---------- 认证（用 openssl rand -hex 32 生成，>=32 字符）----------
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ---------- 微信小程序 ----------
WX_APPID=
WX_SECRET=
WX_MOCK=true
WX_SUBSCRIBE_ENABLED=false
WX_SUBSCRIBE_TEMPLATE_ID=

# ---------- 业务参数 ----------
ATTENDANCE_WINDOW_MINUTES=30
WAITLIST_OFFER_MINUTES=15

# 生产必须 false：否则会写入演示会员/课节/收款
SEED_DEMO=false
