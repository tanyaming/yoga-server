<view class="page">
  <!-- ===== 登录态：按《UI 设计规范 v1.0（FROZEN）》深度还原 ===== -->
  <block wx:if="{{!loggedIn}}">
    <view class="login-stage">
      <!-- §2.2 冷调渐变 + 两处径向柔光：仅页面级背景层，不进入组件 -->
      <view class="login-glow"></view>
      <view class="login-wrap">

        <!-- §3 宋体 H2：顶栏已是「教练工作台」，此处不重复 -->
        <view class="login-head">
          <view class="login-h2">教练登录</view>
          <view class="login-sub">查看今日课表 · 点名消课</view>
        </view>

        <!-- §2.5 辅助文字不得直接落冷底，全部收入白卡面板 -->
        <view class="login-panel">
          <view class="field {{loginErr ? 'is-error' : ''}} {{focusKey === 'username' ? 'is-focus' : ''}}">
            <text class="field-label">账号</text>
            <input class="input" type="text" value="{{username}}" data-k="username"
                   bindinput="onInput" bindfocus="onFocus" bindblur="onBlur"
                   placeholder="请输入教练账号" placeholder-class="ph"
                   confirm-type="next" maxlength="40" />
          </view>

          <view class="field {{loginErr ? 'is-error' : ''}} {{focusKey === 'password' ? 'is-focus' : ''}}">
            <text class="field-label">密码</text>
            <input class="input" password="{{true}}" value="{{password}}" data-k="password"
                   bindinput="onInput" bindfocus="onFocus" bindblur="onBlur"
                   placeholder="请输入密码" placeholder-class="ph"
                   confirm-type="done" maxlength="40" />
          </view>

          <!-- §5 / §7 错误三重编码：红边 + 线性图标 + 文案，不靠颜色 alone -->
          <view wx:if="{{loginErr}}" class="field-error">
            <text class="err-glyph">!</text><text>{{loginErr}}</text>
          </view>

          <!-- §5 主按钮五态：button + hover-class / disabled / loading；本屏唯一酸柠 -->
          <button class="btn btn-primary btn-login {{canSubmit ? '' : 'is-disabled'}}"
                  hover-class="is-pressed" hover-stay-time="80"
                  disabled="{{!canSubmit || loading}}" loading="{{loading}}"
                  bindtap="login">{{loading ? '登录中…' : (canSubmit ? '登录' : '请填写账号与密码')}}</button>
        </view>
      </view>
    </view>
  </block>

  <!-- ===== 工作台态：业务逻辑不变，视觉按规范对齐 ===== -->
  <block wx:else>
    <view class="coach-top">
      <view>
        <view class="coach-name">{{coachName || '教练'}}</view>
        <view class="coach-sub">今日课表</view>
      </view>
      <view class="logout" bindtap="logout">退出</view>
    </view>

    <view wx:if="{{today.length === 0}}" class="empty">今日暂无课程</view>
    <view wx:for="{{today}}" wx:key="id" class="card session-card" bindtap="openRoster" data-id="{{item.id}}">
      <view class="s-time">
        <view class="s-hh mono">{{item.hh}}</view>
        <view class="s-md mono">{{item.md}}</view>
      </view>
      <view class="s-body">
        <view class="s-name">{{item.course_name}}</view>
        <view class="s-meta">{{item.booked}}/{{item.capacity}} 人</view>
      </view>
      <view class="s-state">
        <text wx:if="{{item.status === 'FULL'}}" class="tag tag-clay">已满</text>
        <text wx:elif="{{item.status === 'CANCELLED'}}" class="tag tag-neutral">已取消</text>
        <text wx:else class="tag tag-pine">可点名</text>
      </view>
    </view>

    <view wx:if="{{roster}}" class="mask" bindtap="onMaskTap">
      <view class="dialog roster" catchtap="noop">
        <view class="roster-head">
          <text class="r-title">{{roster.course_name}}</text>
          <text class="r-time">{{roster.starts_at}}</text>
        </view>
        <view class="roster-count">{{roster.booked}} 人已约 · 点击按钮标记到场 / 爽约</view>
        <view wx:for="{{roster.items}}" wx:key="member_id" class="r-item">
          <view class="r-info">
            <view class="r-name">{{item.member_name}}</view>
            <view class="r-phone">{{item.phone_mask}}</view>
          </view>
          <view class="r-actions">
            <text wx:if="{{item.status === 'ATTENDED'}}" class="tag tag-success">已到课</text>
            <text wx:elif="{{item.status === 'NO_SHOW'}}" class="tag tag-clay">爽约</text>
            <block wx:else>
              <view class="r-btn ok" catchtap="mark" data-mid="{{item.member_id}}" data-status="ATTENDED">到课</view>
              <view class="r-btn no" catchtap="mark" data-mid="{{item.member_id}}" data-status="NO_SHOW">爽约</view>
            </block>
          </view>
        </view>
        <view class="btn btn-secondary dialog-btn" catchtap="walkIn">登记临时到店（代约待办）</view>
        <view class="btn btn-secondary dialog-btn" catchtap="closeRoster">关闭</view>
      </view>
    </view>
  </block>
</view>
