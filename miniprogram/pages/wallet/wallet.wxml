<view class="page">
  <view class="app-header">
    <view class="hero-date">会员中心</view>
    <view class="hero-title">我的</view>
  </view>

  <view class="card profile">
    <view class="avatar">{{member.name ? member.name[0] : '?'}}</view>
    <view class="p-info">
      <view class="p-name">{{member.name || '未登录'}}</view>
      <view class="p-phone">{{member.phone_mask || '微信授权后显示'}}</view>
    </view>
    <text class="tag tag-success">会员</text>
  </view>

  <view class="section-title">我的服务</view>
  <view class="card menu">
    <view class="menu-item" bindtap="goEntitlements"><text>我的权益</text><text class="m-arrow">→</text></view>
    <view class="menu-item" bindtap="goMyBookings"><text>我的预约</text><text class="m-arrow">→</text></view>
    <view class="menu-item" bindtap="goBooking"><text>课程表</text><text class="m-arrow">→</text></view>
  </view>

  <view class="section-title">关于</view>
  <view class="card about">
    <view class="a-title">线下收款 · 线上记账</view>
    <view class="a-text">本系统不提供在线支付。购卡、续卡、退款请到前台办理，课时与储值变动会实时写入权益账本，可随时在「权益」页核对流水。</view>
    <view class="a-text">手机号等信息按规范脱敏展示；课时调整均记录操作人与时间。</view>
  </view>

  <!-- 教练入口降级：会员信息旁不再放显眼胶囊，改为底部文字链且受开关控制 -->
  <view wx:if="{{showCoachEntry}}" class="coach-link" bindtap="goCoach">教练登录 · 工作台</view>
</view>
