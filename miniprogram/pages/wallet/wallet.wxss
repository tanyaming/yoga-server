.page { padding-bottom: 40rpx; }

.profile {
  display: flex; align-items: center; gap: 20rpx;
  background: #123A2E; color: #FFFFFF; padding: 40rpx 32rpx;
}
.avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: #D9F26B; color: #123A2E; font-size: 40rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; flex: none;
}
.p-name { font-size: 34rpx; font-weight: 700; }
.p-phone { font-size: 24rpx; color: rgba(255,255,255,.65); }
.coach-entry {
  margin-left: auto; padding: 10rpx 20rpx; border: 1rpx solid rgba(255,255,255,.4);
  border-radius: 999rpx; font-size: 24rpx; color: #D9F26B;
}

.section-title { font-size: 26rpx; color: #5A7073; padding: 28rpx 32rpx 8rpx; }

.ent-card { }
.ent-top { display: flex; justify-content: space-between; align-items: center; }
.ent-name { font-size: 30rpx; font-weight: 600; color: #27393B; }
.ent-row { display: flex; align-items: baseline; gap: 16rpx; margin-top: 16rpx; }
.ent-remain { font-size: 44rpx; font-weight: 700; color: #123A2E; }
.ent-total { font-size: 24rpx; color: #5A7073; }
.ent-expire { font-size: 24rpx; color: #5F7579; margin-top: 8rpx; }

.book-item, .ledger-item { display: flex; justify-content: space-between; align-items: center; }
.book-name { font-size: 30rpx; font-weight: 600; color: #27393B; }
.book-time { font-size: 24rpx; color: #5A7073; }
.lg-remark { font-size: 28rpx; color: #27393B; }
.lg-time { font-size: 22rpx; color: #5F7579; }
.lg-delta { font-size: 30rpx; font-weight: 700; }
