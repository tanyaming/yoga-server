/* 我的：冷白会员卡 + 服务入口 + 线下收款说明 */
.app-header { padding: 24rpx 40rpx 8rpx; }
.hero-date { font-size: 22rpx; color: var(--ink-3); }
.hero-title { font-family: var(--f-cn); font-size: 48rpx; font-weight: 700; color: var(--ink); margin-top: 8rpx; }

.profile { display: flex; align-items: center; gap: 24rpx; }
.avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%; flex: none;
  background: var(--pine); color: var(--paper);
  font-size: 40rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.p-info { flex: 1; min-width: 0; }
.p-name { font-size: 34rpx; font-weight: 700; color: var(--ink); }
.p-phone { font-size: 24rpx; color: var(--ink-2); margin-top: 4rpx; }

.menu { padding: 8rpx 32rpx; }
.menu-item {
  display: flex; align-items: center; justify-content: space-between;
  min-height: 96rpx; font-size: 28rpx; color: var(--ink);
}
.menu-item + .menu-item { border-top: 1rpx solid var(--line-2); }
.m-arrow { font-size: 26rpx; color: var(--muted); }

.about { padding: 28rpx 32rpx; }
.a-title { font-size: 28rpx; font-weight: 700; color: var(--pine); margin-bottom: 16rpx; }
.a-text { font-size: 24rpx; color: var(--ink-2); line-height: 1.7; margin-bottom: 12rpx; }
.a-text:last-child { margin-bottom: 0; }

.coach-link {
  text-align: center; font-size: 22rpx; color: var(--ink-3);
  padding: 40rpx 40rpx 24rpx; text-decoration: underline;
}
